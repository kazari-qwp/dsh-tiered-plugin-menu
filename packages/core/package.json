{
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "url": "git+https://github.com/kazari-qwp/dsh-tiered-plugin-menu.git",
    "type": "git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kazari-qwp/dsh-tiered-plugin-menu#readme",
