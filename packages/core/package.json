  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./shared": {
      "types": "./dist/shared.d.ts",
      "default": "./dist/shared.js"
    },
    "./remote-contract": {
      "types": "./dist/remote-contract.d.ts",
      "default": "./dist/remote-contract.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./isolation": {
      "types": "./dist/isolation.d.ts",
      "default": "./dist/isolation.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.txt",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "name": "dsh-tiered-plugin-core",
  "version": "0.8.0",
  "description": "DSH 分级配置共享核心：继承、实例隔离、MCP 与 Skill 管理。",
  "peerDependencies": {
